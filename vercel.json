{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/cron/prices",
      "schedule": "0 19 * * 1"
    },
    {
      "path": "/cron/prices",
      "schedule": "0 19 * * 2"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "{prompts/**,fixtures/**,data/seed/**}"
    }
  }
}
