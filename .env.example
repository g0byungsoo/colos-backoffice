# Required for live agent, embeddings and judge calls.
OPENAI_API_KEY=
# Required for Sheets mode: id from the sheet URL.
GOOGLE_SHEET_ID=
# Required for Sheets mode: service account JSON, raw or base64.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative to inline JSON: path to the service account key file.
GOOGLE_APPLICATION_CREDENTIALS=
# Agent model with tool calling.
OPENAI_MODEL=gpt-5-mini
# Stronger model used only for eval grading.
OPENAI_JUDGE_MODEL=gpt-5
# Embedding model for the live search index.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Sheets is the default; local uses synthetic CSVs and a local write store.
DATA_SOURCE=sheets
# Display and supplier schedule timezone.
TIMEZONE=America/Los_Angeles
# Local business hours, start inclusive and end exclusive.
BUSINESS_HOURS=08:00-18:00
# Optional owner destination; absent means dry-run transfer.
OWNER_PHONE=
# Minimum margin per container in integer cents, at least 5000.
FLOOR_MARGIN_CENTS=5000
# Optional Stripe test key; absent means dry-run invoice.
STRIPE_SECRET_KEY=
# Optional Twilio signature validation token.
TWILIO_AUTH_TOKEN=
# Optional ElevenLabs integration key.
ELEVENLABS_API_KEY=
# Optional ElevenLabs agent id.
ELEVENLABS_AGENT_ID=
# Optional shared secret for tool requests; missing disables those routes.
TOOL_WEBHOOK_SECRET=
# Optional bearer secret for cron; missing disables remote cron.
CRON_SECRET=
# Optional model reranking, disabled by default.
RAG_RERANK=false
# Local HTTP port.
PORT=3000

# Local artifact root; Vercel entry point uses its temporary directory.
RUNTIME_DIR=.
